---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
import { formatPrice } from '../lib/format';
import { categoryLabel, displayPrice } from '../lib/templates';
import Cover from './Cover.astro';

interface Props {
  entry: CollectionEntry<'templates'>;
  /** Heading level of the card title; pick the level that follows the section heading. */
  level?: 2 | 3;
}
const { entry, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const d = entry.data;
const price = displayPrice(d);
---

<article class="card tcard">
  <div class="tcard-art">
    <Cover category={d.category} shot={d.screenshots[0]} alt={`Обложка: ${d.title}`} />
  </div>
  <div class="tcard-body">
    <div class="tcard-top">
      <span class="badge">{categoryLabel(d.category)}</span>
      {d.status === 'soon' && <span class="badge badge-soon">Скоро</span>}
    </div>
    <Heading class="tcard-title"><a href={url(`templates/${entry.id}/`)}>{d.title}</a></Heading>
    <p class="tcard-for">{d.audience}</p>
    {price !== null && <div class="tcard-price">от {formatPrice(price)}</div>}
  </div>
</article>
