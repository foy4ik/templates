---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../lib/url';

interface Props {
  category: string;
  shot?: ImageMetadata;
  alt: string;
  width?: number;
}
const { category, shot, alt, width = 640 } = Astro.props;
---

{
  shot ? (
    <Image src={shot} alt={alt} width={width} loading="lazy" />
  ) : (
    <img src={url(`placeholders/${category}.svg`)} alt={alt} width="640" height="400" loading="lazy" />
  )
}
