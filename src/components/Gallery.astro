---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Cover from './Cover.astro';

interface Props {
  shots: ImageMetadata[];
  category: string;
  title: string;
}
const { shots, category, title } = Astro.props;
---

{
  shots.length === 0 ? (
    <div class="cover">
      <Cover category={category} alt={`Заглушка обложки: ${title}`} width={560} />
    </div>
  ) : (
    <>
      <div class="thumbs">
        {shots.map((s, i) => (
          <button type="button" class="thumb" data-open={i} aria-label={`Открыть скриншот ${i + 1}`}>
            <Image src={s} alt={`Скриншот ${i + 1}: ${title}`} width={320} loading="lazy" />
          </button>
        ))}
      </div>
      <dialog class="gallery-dialog" id="gallery" aria-label={`Скриншоты: ${title}`}>
        <button type="button" class="btn btn-ghost btn-sm gallery-close" data-close>Закрыть ✕</button>
        <div class="gallery-track">
          {shots.map((s, i) => (
            <div class="gallery-slide" id={`shot-${i}`}>
              <Image src={s} alt={`Скриншот ${i + 1}: ${title}`} width={1200} loading="lazy" />
            </div>
          ))}
        </div>
      </dialog>
      <script>
        const dialog = document.getElementById('gallery') as HTMLDialogElement | null;
        if (dialog) {
          let opener: HTMLElement | null = null;
          document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) =>
            b.addEventListener('click', () => {
              opener = b;
              dialog.showModal();
              const slide = dialog.querySelector<HTMLElement>(`#shot-${b.dataset.open}`);
              slide?.scrollIntoView({ inline: 'center', block: 'nearest' });
            }),
          );
          dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
          dialog.addEventListener('click', (e) => {
            if (e.target === dialog || (e.target as HTMLElement).classList.contains('gallery-slide')) dialog.close();
          });
          dialog.addEventListener('close', () => opener?.focus());
        }
      </script>
    </>
  )
}
