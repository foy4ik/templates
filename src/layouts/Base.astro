---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import { url, absoluteUrl } from '../lib/url';
import { siteConfig } from '../../site.config';
import { robotsMeta } from '../lib/seo';
import interLatin from '../assets/fonts/inter-latin-wght-normal.woff2?url';
import interCyrillic from '../assets/fonts/inter-cyrillic-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OrderModal from '../components/OrderModal.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Absolute URL of the Open Graph image. Defaults to the generic cover. */
  image?: string;
  /** JSON-LD object, rendered when present. */
  ld?: object | null;
  ogType?: 'website' | 'product';
}
const { title, description = 'Готовые боты и сайты: запустите за вечер или закажите установку под ключ.', noindex = false, image, ld = null, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).href;
const ogImage = image ?? absoluteUrl('og/default.png');
const robots = robotsMeta(siteConfig.indexing, noindex);
const metrikaId = siteConfig.metrikaId;
const metrikaSnippet = `(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");ym(${metrikaId},"init",{clickmap:true,trackLinks:true,accurateTrackBounce:true});`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Шаблоны" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preload" href={interCyrillic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {metrikaId && <script is:inline set:html={metrikaSnippet} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <OrderModal />
    {metrikaId && <noscript><div><img src={`https://mc.yandex.ru/watch/${metrikaId}`} style="position:absolute;left:-9999px" alt="" /></div></noscript>}
  </body>
</html>
